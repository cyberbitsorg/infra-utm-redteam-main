# infra-utm-redteam-main configuration
# Copy to lab.conf and adjust. lab.conf is gitignored.

# --- Identity ---------------------------------------------------------------
# Prefix for the UTM VM name, so the box is easy to spot: <LAB_PREFIX>-<name>.
LAB_PREFIX="redteam"

# User created inside the VM (cloud-init); Ansible connects as this user. Avoid
# a name that is already a system group in the guest (operator, staff, games,
# users); cloud-init handles the clash, but a free name is simpler.
LAB_USER="redteam"

# Public SSH key injected into the VM. scripts/preflight.sh generates one if
# the file does not exist.
LAB_SSH_KEY="${HOME}/.ssh/id_ed25519_redteam.pub"

# --- Networking -------------------------------------------------------------
# How the single NIC is attached:
#   nat     : emulated SLIRP NIC. Internet + LAN visibility plus a 127.0.0.1
#             SSH port-forward ('make ssh'). Portable; works on any Wi-Fi.
#   bridged : vmnet-bridged NIC. The box gets its own DHCP IP on the physical
#             LAN (LLMNR/NBNS poisoning, ARP spoof, inbound callbacks). No host
#             port-forward; 'make ssh' uses the discovered LAN IP.
NET_MODE="nat"

# --- Console and desktop ----------------------------------------------------
# Password for the lab user on the console and the LightDM greeter. SSH stays
# key-only regardless. lab.conf is gitignored, so this never lands in git.
ATTACKER_PASSWORD="redteam"

# Graphical desktop rendered in UTM's window: 'xfce' (default) or 'none'.
ATTACKER_GUI="xfce"

# Share the clipboard between macOS and the desktop (SPICE): 'yes' or 'no'.
CLIPBOARD="yes"

# Host folder shared live into the guest, where it is mounted under the same
# name in the lab user's home (~/Sandbox by default). Rename it here and both
# sides follow. Kept outside the repo so engagement files never land in a git
# working tree. The folder must be pointed at once in UTM's VM settings; see
# the README. The folder name cannot contain spaces (it becomes an fstab entry).
SANDBOX_DIR="${HOME}/Sandbox"

# --- Toolset ----------------------------------------------------------------
# Which Kali toolset to install. Bigger = slower first 'make up'.
#   curated  : small headless subset (nmap, hydra, sqlmap, ffuf, ...)
#   headless : kali-linux-headless
#   default  : kali-linux-default (the standard installer toolset)
#   large    : kali-linux-large
KALI_TOOLSET="default"

# --- Persistence ------------------------------------------------------------
# A second disk in persist/ that survives 'make destroy' and is re-attached on
# the next 'make up', so a rebuild gives a fresh OS with your work intact.
#   data : mounted at /data, with ~/engagements -> /data. Home and dotfiles
#          are clean on every rebuild.
#   home : the disk holds /home, so dotfiles, keys and tool state survive a
#          rebuild too (no clean home on rebuild).
PERSIST_MODE="data"

# Size of the persistent disk at first creation, in GB. Never shrunk.
DATA_DISK_GB=40

# --- Virtual machine --------------------------------------------------------
# The UTM VM is named <LAB_PREFIX>-<VM_NAME>.
VM_NAME="kali"
VM_CPU=4
VM_RAM=8192
VM_DISK_GB=80

# --- Base image (ARM64 / aarch64) -------------------------------------------
# Kali genericcloud, from the per-release directory (never current/, which 404s
# the moment Kali cuts a release). Bump KALI_VERSION to any release listed at
# https://kali.download/cloud-images/.
KALI_VERSION="2026.2"
KALI_IMG_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/kali-linux-${KALI_VERSION}-cloud-genericcloud-arm64.tar.xz"
KALI_SHA_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/SHA256SUMS"
KALI_IMG_FILE="kali-genericcloud-arm64.raw"
