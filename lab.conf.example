# infra-utm-redteam-main config. Copy to lab.conf (gitignored) and adjust.

# --- Identity ---
# LAB_PREFIX is for the VM. VM is named <LAB_PREFIX>-<VM_NAME>
# LAB_USER is created by cloud-init; Ansible connects as this user
# LAB_SSH_KEY is your SSH key, preflight creates one
LAB_PREFIX="redteam"
LAB_USER="redteam"
LAB_SSH_KEY="${HOME}/.ssh/id_ed25519_redteam.pub"

# --- Console and desktop ---
# ATTACKER_PASSWORD for console + LightDM only; SSH stays key-only
# ATTACKER_GUI can be xfce or none
ATTACKER_PASSWORD="redteam"
ATTACKER_GUI="xfce"

# Guest renders on the CPU (see VM_DISPLAY in lib.sh), so pixel count decides smoothness.
# One guest pixel is one macOS point (UTM NativeResolution is off), so a mode taller than
# your display's point height gets scaled down rather than showing more.
#   <WxH>   pinned, UTM scales. Xorg silently ignores a mode the virtual monitor does not
#           offer; 'xrandr' in the guest lists them all. The usable ones: 1920x1440,
#           1920x1200, 1920x1080, 1856x1392, 2048x1152, 1792x1344, 1680x1050, 1600x1200,
#           1400x1050, 1440x900, 1280x1024, 1024x768
#   dynamic follow the window; every resize is a mode change, locks up at Retina sizes
DISPLAY_RESOLUTION="1920x1080"

# DESKTOP_COMPOSITING is for XFCE shadows/fades, full-screen CPU redraws
# CLIPBOARD is SPICE clipboard sharing with macOS
DESKTOP_COMPOSITING="no"
CLIPBOARD="yes"

# AUDIO sends guest sound to the Mac's current default output device. The card is added
# by hand in UTM once; this knob only does the guest side. See README.
AUDIO="no"

# Host folder shared live into the guest under the same name. Outside the repo so engagement
# files never hit a git tree; no spaces (fstab entry). Point UTM at it once, see README.
SHARED_DIR="${HOME}/Sandbox"

# Mullvad VPN + Browser from Mullvad's signed apt repo (yes | no). VPN works headless via the
# 'mullvad' CLI; browser needs a desktop and is the arm64 alpha build. Log in with 'mullvad
# account login <number>'. 'no' purges both and drops the account. Provisioning enables LAN
# sharing so the kill switch can't drop your SSH session; see README.
MULLVAD="no"

# curated (minimal) | headless | default | large. Bigger = slower first build.
KALI_TOOLSET="default"

# Keep /home across a rebuild, or not. Changing it needs 'make destroy' + 'make up':
#   yes  /home is a second disk in persist/ that 'make destroy' keeps
#   no   no second disk at all, so every rebuild starts with an empty home
KEEP_HOME="yes"

# Size of that second disk at first creation; never shrunk. Ignored with KEEP_HOME=no.
DATA_DISK_GB=40

# --- Virtual machine ---
VM_NAME="kali"
VM_CPU=4
VM_RAM=8192
VM_DISK_GB=80

# --- Base image (ARM64) ---
# Kali genericcloud, per-release dir (never current/, which 404s on each release).
# Bump to any release at https://kali.download/cloud-images/.
KALI_VERSION="2026.2"
KALI_IMG_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/kali-linux-${KALI_VERSION}-cloud-genericcloud-arm64.tar.xz"
KALI_SHA_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/SHA256SUMS"
KALI_IMG_FILE="kali-genericcloud-arm64.raw"
