#!/usr/bin/env bash
# Switch the virtual monitor to one of the modes DISPLAY_RESOLUTION defined.
# Managed by Ansible. Do not edit.
set -euo pipefail

mode="${1:-}"
if [[ -z "$mode" ]]; then
  echo "usage: lab-screen <width>x<height>" >&2
  exit 2
fi

# Resolve the output rather than assuming Virtual-1.
output=""
for c in /sys/class/drm/card*-*/; do
  [ "$(cat "${c}status" 2>/dev/null)" = "connected" ] || continue
  output="$(basename "$c" | sed 's/^card[0-9]*-//')"
  break
done
[[ -n "$output" ]] || { echo "lab-screen: no connected output found" >&2; exit 1; }

if ! xrandr | grep -qE "^[[:space:]]+${mode}[[:space:]]"; then
  {
    echo "lab-screen: ${output} does not offer ${mode}. Available:"
    xrandr | sed -n 's/^ \{3,\}\([0-9]\{3,\}x[0-9]\{3,\}\).*/  \1/p' | sort -u
  } >&2
  exit 1
fi

xrandr --output "$output" --mode "$mode"

# spice-vdagentd sizes its virtual tablet when it creates the uinput device and
# never resizes it on a RandR change, so after a mode switch clicks land
# off-target in proportion to the difference. Recreating the device resyncs it.
# It has to be the daemon: spice-vdagent (no trailing d) does not own /dev/uinput.
if systemctl is-active --quiet spice-vdagentd 2>/dev/null; then
  # Let vdagent see the RandR event and report the new size first.
  sleep 1
  if ! sudo -n systemctl restart spice-vdagentd 2>/dev/null; then
    echo "lab-screen: mode is now ${mode}, but spice-vdagentd could not be" >&2
    echo "  restarted, so mouse clicks will be offset. Run:" >&2
    echo "    sudo systemctl restart spice-vdagentd" >&2
    exit 1
  fi
fi
